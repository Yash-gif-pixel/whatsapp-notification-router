# ---------------------------------------------------------------------------
# Project-specific rules
# ---------------------------------------------------------------------------

# Secrets - never commit. .env holds real API keys; .env.example is the safe,
# committed template documenting which variables are needed.
.env
.env.*
!.env.example

# Hackathon-provided dataset. Not redistributed publicly - licensing unverified.
# The README documents its structure and contents instead.
dataset/

# Submission archives - build artifacts, not source.
*.zip

# NOTE: code/artifacts/*.json is deliberately NOT ignored. Those two cache
# files are what let the pipeline reproduce output.csv with no API key.

# ---------------------------------------------------------------------------
# GitHub standard Python template
# ---------------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# mypy / type checkers
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Jupyter Notebook
.ipynb_checkpoints
profile_default/
ipython_config.py

# IDEs
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
