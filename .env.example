# Template for the local .env file. Safe to commit - contains no real keys.
#
# Copy this to .env and paste your keys in:
#     cp .env.example .env
#
# Gemini is multimodal, so a Gemini-only setup covers everything:
# images go to Gemini vision, voice notes to Gemini audio.
# Get a key at https://aistudio.google.com/apikey

# Required. Used for voice transcription, and for image description too
# unless a second key or an Anthropic key is set below.
GEMINI_API_KEY=

# Optional second Gemini key - when set, images use it so image and audio
# work draw on separate quota. Leave blank to use one key for both.
GEMINI_API_KEY_2=

# --- optional ----------------------------------------------------------
# Only if you have an Anthropic key and want Claude to describe images
# instead of Gemini. The code falls back to Gemini automatically.
# ANTHROPIC_API_KEY=

# Force a provider for images: anthropic | gemini
# ORCHESTRATE_VISION_PROVIDER=gemini

# Model overrides. Defaults: gemini-2.5-flash for both modalities
# (or claude-opus-5 for images when an Anthropic key is present).
# ORCHESTRATE_VISION_MODEL=gemini-2.5-flash
# ORCHESTRATE_AUDIO_MODEL=gemini-2.5-flash
